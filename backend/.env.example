# Copy to .env for local development. NEVER commit a real .env file.
# CockroachDB / Postgres-compatible connection string.
DATABASE_URL=postgresql+asyncpg://user:password@host:26257/defaultdb?ssl=verify-full
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:1420,tauri://localhost
